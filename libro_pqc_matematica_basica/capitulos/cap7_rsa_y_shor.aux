\newlabel{cap:rsa_y_shor}{{7}{30}{El Candado de Ayer: RSA y por qué las Computadoras Cuánticas lo Rompen}{chapter.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.1}El mundo antes de la criptografía de retículos}{30}{section.7.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7.2}El corazón de RSA: La multiplicación es fácil, la factorización no}{30}{section.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces La asimetría de la factorización: fácil hacia adelante, imposible hacia atrás para computadoras clásicas, pero trivial para Shor cuántico.}}{31}{figure.7.1}\protected@file@percent }
\newlabel{fig:factorizacion}{{7.1}{31}{La asimetría de la factorización: fácil hacia adelante, imposible hacia atrás para computadoras clásicas, pero trivial para Shor cuántico}{figure.7.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.3}El funcionamiento de RSA paso a paso}{31}{section.7.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7.4}La amenaza cuántica: El algoritmo de Shor}{32}{section.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces La diferencia fundamental: con $n=300$ qubits, una computadora cuántica puede explorar $2^{300}$ estados simultáneamente. Ese número supera la cantidad de átomos en el universo observable.}}{33}{figure.7.2}\protected@file@percent }
\newlabel{fig:clasico_vs_cuantico}{{7.2}{33}{La diferencia fundamental: con $n=300$ qubits, una computadora cuántica puede explorar $2^{300}$ estados simultáneamente. Ese número supera la cantidad de átomos en el universo observable}{figure.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Flujo simplificado del algoritmo de Shor. El paso crítico (detectar el período $r$) es exponencialmente difícil para computadoras clásicas pero se resuelve en tiempo polinomial con qubits cuánticos.}}{33}{figure.7.3}\protected@file@percent }
\newlabel{fig:shor_flujo}{{7.3}{33}{Flujo simplificado del algoritmo de Shor. El paso crítico (detectar el período $r$) es exponencialmente difícil para computadoras clásicas pero se resuelve en tiempo polinomial con qubits cuánticos}{figure.7.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.5}¿Por qué una computadora cuántica encuentra el período tan rápido?}{34}{section.7.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces La QFT cuántica detecta el período $r$ de $f(x)$ en un solo paso: busca los picos de frecuencia en el espectro, que están separados exactamente por $N/r$.}}{34}{figure.7.4}\protected@file@percent }
\newlabel{fig:qft}{{7.4}{34}{La QFT cuántica detecta el período $r$ de $f(x)$ en un solo paso: busca los picos de frecuencia en el espectro, que están separados exactamente por $N/r$}{figure.7.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.6}¿Y los retículos? La inmunidad a Shor}{35}{section.7.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces La razón geométrica de la inmunidad post-cuántica: RSA tiene una señal periódica limpia que Shor detecta; LWE tiene ruido puro sin patrón que ningún algoritmo cuántico puede explotar.}}{35}{figure.7.5}\protected@file@percent }
\newlabel{fig:rsa_vs_lwe_shor}{{7.5}{35}{La razón geométrica de la inmunidad post-cuántica: RSA tiene una señal periódica limpia que Shor detecta; LWE tiene ruido puro sin patrón que ningún algoritmo cuántico puede explotar}{figure.7.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.7}El estado actual de las computadoras cuánticas}{35}{section.7.7}\protected@file@percent }
